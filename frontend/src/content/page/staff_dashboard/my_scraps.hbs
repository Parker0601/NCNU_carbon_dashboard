{{#> 
    layouts/main 
    title="我的廢料紀錄" 
    pagename="staff_my_scraps"
    heading="我的廢料紀錄"
    category_1="員工專區"
    pagedescription="檢視自己填報的所有入料紀錄"
}}

{{#*inline "head-block"}}
  <link rel="stylesheet" href="/css/notifications/sweetalert2/sweetalert2.bundle.css">

  <style>
    /* 卡片與表格的細節微調 */
    .card.my-scraps-card { border-radius: 1rem; }
    .table.my-scraps-table thead th {
      position: sticky; top: 0; z-index: 1;
      background: var(--theme-primary-50, #f8f9fa);
    }
    .table.my-scraps-table td, .table.my-scraps-table th {
      vertical-align: middle;
      white-space: nowrap;
    }
    .table.my-scraps-table .col-id      { width: 80px; }
    .table.my-scraps-table .col-device  { min-width: 160px; }
    .table.my-scraps-table .col-type    { min-width: 120px; }
    .table.my-scraps-table .col-weight  { width: 120px; }
    .table.my-scraps-table .col-status  { width: 120px; }
    .table.my-scraps-table .col-actions { width: 220px; }
    .toolbar .btn + .btn { margin-left: .5rem; }
    .badge.rounded-pill { border-radius: 999px; padding: .35rem .6rem; }
  </style>
{{/inline}}

{{#*inline "content-block"}}
<div class="row">
  <div class="col-12">
    <div class="card my-scraps-card shadow-sm">
      <div class="card-header d-flex align-items-center justify-content-between">
        <div>
          <h4 class="mb-0">我的廢料紀錄</h4>
          <small class="text-muted">檢視自己填報的所有入料紀錄</small>
        </div>
        <div class="toolbar d-flex align-items-center">
          <button id="btn-refresh" class="btn btn-outline-primary">
            <i class="fal fa-sync"></i> 重新整理
          </button>
          <a href="/waste_management" class="btn btn-secondary">
            <i class="fal fa-arrow-left"></i> 返回入料作業
          </a>
        </div>
      </div>

      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-sm table-striped table-hover my-scraps-table mb-0" id="my-scraps-table">
            <thead class="thead-light">
              <tr>
                <th class="col-id">ID</th>
                <th class="col-device">設備</th>
                <th class="col-type">類型</th>
                <th class="col-weight">重量 (kg)</th>
                <th class="col-status">狀態</th>
                <th class="col-actions text-right pr-3">操作</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        </div>
      </div>

      <div class="card-footer text-muted small">
        提示：點擊「查看」可快速檢視詳細欄位；「編輯」會帶入對應的設備進入入料頁。
      </div>
    </div>
  </div>
</div>
{{/inline}}

{{#*inline "scripts-block"}}
  <script src="/js/notifications/sweetalert2/sweetalert2.bundle.js"></script>
  <script src="/js/staff/my_scrap.js"></script>
  <script>
    // 綁定「重新整理」按鈕
    document.addEventListener('DOMContentLoaded', function () {
      const btn = document.getElementById('btn-refresh');
      if (btn && typeof window.loadMyScraps === 'function') {
        btn.addEventListener('click', () => window.loadMyScraps?.());
      }
    });
  </script>
{{/inline}}

{{/layouts/main}}
