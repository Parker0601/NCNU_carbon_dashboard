{{#> 
    layouts/main 
    title="員工升級管理" 
    pagename="boss_employee_promotion"
    heading="員工升級管理"
    category_1="老闆專區"
    pagedescription="維護員工等級、升遷申請與審核流程"
}}

{{!-- 1) HEAD --}}
{{#*inline "head-block"}}
<link rel="stylesheet" media="screen, print" href="/css/vendors.bundle.css"/>
<link rel="stylesheet" media="screen, print" href="/css/app.bundle.css"/>
<style>
  .search-container { margin-bottom: 16px; }
  .table-container { margin-bottom: 28px; }
  .btn-upgrade, .btn-approve, .btn-reject { font-size: 0.9rem; }
  .panel .panel-hdr h2 { font-weight: 700; font-size: 1.15rem; }
  .muted-row { color: #888; }
</style>
{{/inline}}

{{!-- 2) CONTENT --}}
{{#*inline "content-block"}}
<div class="row">
  <div class="col-12">
    <div class="panel">
      <div class="panel-hdr"><h2>員工升級管理</h2></div>
      <div class="panel-container show p-3">

        <!-- 搜尋 -->
        <div class="search-container">
          <input type="text" class="form-control" id="searchInput" placeholder="搜尋員工姓名…">
        </div>

        <!-- 員工列表 -->
        <div class="table-container">
          <h3 class="mb-2">員工列表</h3>
          <div id="js-upgrade-alert" class="alert" role="alert" style="display:none"></div>
          <div class="table-responsive">
            <table class="table table-sm table-striped">
              <thead>
                <tr>
                  <th style="width:30%">名字</th>
                  <th style="width:40%">職位</th>
                  <th style="width:30%">操作</th>
                </tr>
              </thead>
              <tbody id="employeeList">
                <tr class="muted-row"><td colspan="3">載入中…</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        {{!-- 審核列表 - 已註解，老闆可直接升級員工 --}}
        {{!--
        <div class="table-container">
          <h3 class="mb-2">審核列表</h3>
          <div class="table-responsive">
            <table class="table table-sm table-striped">
              <thead>
                <tr>
                  <th style="width:26%">名字</th>
                  <th style="width:18%">ID</th>
                  <th style="width:28%">職位</th>
                  <th style="width:28%">操作</th>
                </tr>
              </thead>
              <tbody id="reviewList">
                <tr class="muted-row"><td colspan="4">載入中…</td></tr>
              </tbody>
            </table>
          </div>
        </div>
        --}}

        {{!-- ================== 前端用 Handlebars 模板 ================== --}}
        <!-- 注意：用 [[ ]] 包住，避免被外層 HBS 先吃掉 -->

        <script id="employee-template" type="text/x-handlebars-template">
          [[#each employees]]
          <tr>
            <td>[[name]]</td>
            <td>[[position]]</td>
            <td>
              <button id="js-upgrade-btn-[[id]]" class="btn btn-primary btn-upgrade" data-id="[[id]]" data-name="[[name]]" data-role="2">升級為主管</button>
            </td>
          </tr>
          [[/each]]
        </script>

        {{!-- 審核模板 - 已註解，老闆可直接升級員工 --}}
        {{!--
        <script id="review-template" type="text/x-handlebars-template">
          [[#each reviews]]
          <tr>
            <td>[[name]]</td>
            <td>[[id]]</td>
            <td>[[position]]</td>
            <td>
              <button id="js-approve-btn-[[id]]" class="btn btn-success btn-approve" data-id="[[id]]" data-name="[[name]]">是</button>
              <button id="js-reject-btn-[[id]]" class="btn btn-danger btn-reject" data-id="[[id]]" data-name="[[name]]">否</button>
            </td>
          </tr>
          [[/each]]
        </script>
        --}}

      </div>
    </div>
  </div>
</div>
{{/inline}}

{{!-- 3) SCRIPTS：先載 Handlebars（CDN），再載你現有的 bundle 與 page JS --}}
{{#*inline "scripts-block"}}
<script src="js/statistics/handlebars/handlebars.min.js"></script>
<script src="js/boss/boss_upgrade.js"></script>
{{/inline}}

{{/layouts/main}}
