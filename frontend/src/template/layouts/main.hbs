<!DOCTYPE html>
{{> include/_copyright-header}}
<html lang="en">
  <head>
    {{> include/_head}}

    {{#> head-block}}
      <!-- 1) 全站認證工具 -->
      <script src="js/auth.js"></script>

      <!-- 2) ultra-early：快取角色避免閃爍 -->
      <script>
        (function () {
          var cached = localStorage.getItem('userRole') || localStorage.getItem('currentRole');
          var map = { '1':'staff','2':'manager','3':'boss' };
          var role = map[String(cached)] || cached;
          if (role) document.documentElement.setAttribute('data-user-role', role);
          document.body && document.body.setAttribute('data-loaded', 'false');
        })();
      </script>

      <!-- 3) 防閃爍 CSS -->
      <style>
        body:not([data-loaded="true"]) .role-nav-item { display: none !important; }
        .role-nav-item { display: none !important; }
        html[data-user-role="boss"]    .role-nav-item[data-role="boss"],
        html[data-user-role="manager"] .role-nav-item[data-role="manager"],
        html[data-user-role="staff"]   .role-nav-item[data-role="staff"] {
          display: block !important;
        }
        #js-nav-menu { visibility: hidden !important; }
      </style>

      <!-- 4) 你原本的 page-settings 與 manager-nav -->
      {{#each page-settings.js}}
        <script src="{{this}}"></script>
      {{/each}}
      <script src="js/manager-nav.js"></script>
    {{/head-block}}
  </head>
  <!-- BEGIN Body -->
  <body class="mod-bg-1 mod-nav-link {{preemptiveclass}}">
    
    {{!-- save-settings-script --}}
    {{> include/_scripts-loading-saving}}
    
    <!-- BEGIN Page Wrapper -->
    <div class="page-wrapper">
      <div class="page-inner">

        {{> include/_left-panel }}

        <div class="page-content-wrapper">
          
          {{> include/_page-header }}

          <!-- BEGIN Page Content -->
          <main id="js-page-content" role="main" class="page-content">
            {{#if preemptiveclass}}
              <!-- Page heading removed for composed layout -->
            {{else}}
              {{> include/_page-breadcrumb }}
              <div class="subheader">
                {{> include/_page-heading }}
                {{#> subheader-block}}{{/subheader-block}}
              </div>
            {{/if}}
            {{#>content-block}}{{/content-block}}
          </main>
          <!-- END Page Content -->

          {{> include/_page-content-overlay }}
          {{> include/_page-footer }}
          {{> include/_shortcut-modal }}
          {{> include/_color-profile-reference }}
          
        </div>
      </div>
    </div>
    <!-- END Page Wrapper -->
    
    {{> include/_shortcut-menu }}
    {{> include/_shortcut-messenger }}
    {{> include/_page-settings }}
    {{> include/_google_analytics }}

    {{!-- 先載入 SmartAdmin bundles --}}
    {{> include/_scripts-base-plugins}}

    {{!-- 再載入角色控制邏輯 --}}
    <script src="js/role-nav.js"></script>

    {{#>scripts-block}}
      {{!-- Custom scripts per page can be added. --}}
    {{/scripts-block}}
  </body>
  <!-- END Body -->
</html>
