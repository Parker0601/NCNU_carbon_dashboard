{{#> 
    layouts/main 
    title="廢料處理記錄" 
    pagename="waste_management"
    heading="廢料處理記錄"
    category_1="員工專區"
    pagedescription="以設備為單位查看/登錄廢料入料資訊並查看報表"
}}

{{#*inline "head-block"}}
<link rel="stylesheet" media="screen, print" href="css/notifications/sweetalert2/sweetalert2.bundle.css">
<script src="/js/vendor/chart.umd.js"></script>
<style>
  /* 我的紀錄表格樣式 */
  .card.my-scraps-card { border-radius: 1rem; }
  .table.my-scraps-table thead th {
    position: sticky; top: 0; z-index: 1;
    background: var(--theme-primary-50, #f8f9fa);
  }
  .table.my-scraps-table td, .table.my-scraps-table th {
    vertical-align: middle;
    white-space: nowrap;
  }
  .table.my-scraps-table .col-id      { width: 80px; }
  .table.my-scraps-table .col-device  { min-width: 160px; }
  .table.my-scraps-table .col-type    { min-width: 120px; }
  .table.my-scraps-table .col-weight  { width: 120px; }
  .table.my-scraps-table .col-status  { width: 120px; }
  .table.my-scraps-table .col-actions { width: 220px; }
  .toolbar .btn + .btn { margin-left: .5rem; }
  .badge.rounded-pill { border-radius: 999px; padding: .35rem .6rem; }
</style>
{{/inline}}

{{#*inline "content-block"}}
<!-- 切換按鈕列 -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <button id="btn-card-view" class="btn btn-outline-primary btn-sm active">廢料卡片</button>
    <button id="btn-report-view" class="btn btn-outline-secondary btn-sm">廢料報表</button>
    <button id="btn-my-scraps-view" class="btn btn-outline-secondary btn-sm">我的紀錄</button>
  </div>
  <div>
    <button id="btn-waste-refresh" class="btn btn-outline-info btn-sm mr-2">
      <i class="fal fa-sync-alt"></i> 刷新數據
    </button>
    <h4 class="m-0 d-inline">入料資訊</h4>
  </div>
</div>

<!-- 卡片視圖：一台設備一張卡 -->
<div id="waste-card-view">
  <div class="row" id="waste-card-list">
    <!-- 由 JS 動態產生設備卡片 -->
  </div>
</div>

<!-- 報表視圖 -->
<div id="waste-report-view" style="display:none;">
  <div class="row mt-4">
    <div class="col-12">
      <div class="panel">
        <div class="panel-hdr">
          <h2>廢料報表</h2>
          <div class="panel-toolbar">
            <select id="waste-report-selector" class="form-control form-control-sm">
              <option value="daily_trend">每日入料趨勢（依設備彙總）</option>
              <option value="by_device_total">各設備入料總量（長條圖）</option>
              <option value="by_type_distribution">廢料類型分布（圓餅圖）</option>
              <option value="weekly_trend">每週入料趨勢</option>
              <option value="monthly_trend">每月入料趨勢</option>
            </select>
          </div>
        </div>
        <div class="panel-container show">
          <div class="panel-content">
            <div id="waste-report-container">
              <canvas id="waste-report-canvas" height="120"></canvas>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 我的紀錄視圖 -->
<div id="waste-my-scraps-view" style="display:none;">
  <div class="row">
    <div class="col-12">
      <div class="card my-scraps-card shadow-sm">
        <div class="card-header d-flex align-items-center justify-content-between">
          <div>
            <h4 class="mb-0">我的廢料紀錄</h4>
            <small class="text-muted">檢視自己填報的所有入料紀錄</small>
          </div>
          <div class="toolbar d-flex align-items-center">
            <button id="btn-my-scraps-refresh" class="btn btn-outline-primary">
              <i class="fal fa-sync"></i> 重新整理
            </button>
          </div>
        </div>

        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-sm table-striped table-hover my-scraps-table mb-0" id="my-scraps-table">
              <thead class="thead-light">
                <tr>
                  <th class="col-id">ID</th>
                  <th class="col-device">設備</th>
                  <th class="col-type">類型</th>
                  <th class="col-weight">重量 (kg)</th>
                  <th class="col-status">狀態</th>
                  <th class="col-actions text-right pr-3">操作</th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>

        <div class="card-footer text-muted small">
          提示：點擊「查看」可快速檢視詳細欄位；「編輯」會帶入對應的設備進入入料頁。
        </div>
      </div>
    </div>
  </div>
</div>

<!--（可選）Handlebars 卡片樣板，若你想在 JS 端用模板渲染 -->
<script id="waste-card-template" type="text/x-handlebars-template">
  <div class="col-xl-4 col-lg-6 col-md-6">
    <div class="card mb-3">
      <div class="card-header d-flex justify-content-between align-items-center">
        <div>
          <h5 class="card-title mb-0">{{deviceName}}</h5>
          <small class="text-muted">設備代碼：{{deviceCode}}</small>
        </div>
        <span class="badge {{statusClass}}">{{statusText}}</span>
      </div>
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <div>
            <div class="text-muted small">近7日入料總量</div>
            <div class="font-weight-bold">{{recentTotal}} kg</div>
          </div>
          <div class="text-right">
            <div class="text-muted small">最新入料</div>
            <div class="font-weight-bold">{{lastInputAmount}} kg</div>
            <div class="small text-muted">{{lastInputAt}}</div>
          </div>
        </div>
        <div class="progress mb-3" style="height:8px;">
          <div class="progress-bar" role="progressbar" style="width: {{utilPercent}}%;" aria-valuenow="{{utilPercent}}" aria-valuemin="0" aria-valuemax="100"></div>
        </div>
        <div class="d-flex justify-content-end">
          {{#if canFill}}
            <button 
              class="btn btn-sm btn-primary btn-fill-input" 
              data-device-id="{{deviceId}}"
              data-device-name="{{deviceName}}"
            >
              填寫入料資訊
            </button>
          {{/if}}
        </div>
      </div>
    </div>
  </div>
</script>
{{/inline}}

{{#*inline "scripts-block"}}
<script src="js/notifications/sweetalert2/sweetalert2.bundle.js"></script>
<script src="/js/login.js"></script>
<!-- 你的頁面控制腳本（請在此檔中處理：切換視圖、抓設備列表、渲染卡片、導向入料頁、載入報表圖表） -->
<script src="/js/staff/waste_management.js"></script>
{{/inline}}

{{/layouts/main}}
