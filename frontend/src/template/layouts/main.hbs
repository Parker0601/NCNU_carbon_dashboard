<!DOCTYPE html>
{{> include/_copyright-header}}
<html lang="en">
  <head>
    {{> include/_head}}

    {{#> head-block}}
      <!-- 1) 全站認證工具（只載一次） -->
      <script src="js/auth.js"></script>

      <!-- 2) ultra-early：從快取角色避免閃爍 -->
      <script>
        (function () {
          var cached = localStorage.getItem('userRole') || localStorage.getItem('currentRole');
          var map = { '1':'staff','2':'manager','3':'boss' };
          var role = map[String(cached)] || cached;
          if (role) document.documentElement.setAttribute('data-user-role', role);
          document.body && document.body.setAttribute('data-loaded', 'false');
        })();
      </script>

      <!-- 3) 防閃爍 CSS -->
      <style>
        body:not([data-loaded="true"]) .role-nav-item { display: none !important; }
        .role-nav-item { display: none !important; }
        html[data-user-role="boss"]    .role-nav-item[data-role="boss"],
        html[data-user-role="manager"] .role-nav-item[data-role="manager"],
        html[data-user-role="staff"]   .role-nav-item[data-role="staff"] {
          display: block !important;
        }
        #js-nav-menu { visibility: hidden !important; }
      </style>

      <!-- 4) 需要的其他 head 資源（若有） -->
      {{#each page-settings.js}}
        <script src="{{this}}"></script>
      {{/each}}

      <!-- 5) 提前執行 ensureAuth，通過後解除防閃 -->
      <script>
        (async function () {
          var PUBLIC_PAGES = ['/page_login', '/page_register', '/403', '/404'];

          if (PUBLIC_PAGES.includes(location.pathname)) {
            document.body && document.body.setAttribute('data-loaded', 'true');
            var m = document.getElementById('js-nav-menu');
            if (m && m.style) m.style.visibility = 'visible';
            return;
          }

          function getRequiredRoles() {
            var rr = (document.body && document.body.getAttribute('data-required-roles')) || '';
            return rr.split(',').map(function (s) { return s.trim(); }).filter(Boolean);
          }

          function showNav() {
            document.body && document.body.setAttribute('data-loaded', 'true');
            var menu = document.getElementById('js-nav-menu');
            if (menu && menu.style) menu.style.visibility = 'visible';
          }

          try {
            var tries = 0;
            while (!(window.Auth && typeof Auth.ensureAuth === 'function') && tries < 10) {
              await new Promise(function (r) { setTimeout(r, 10); });
              tries++;
            }
            var requiredRoles = getRequiredRoles();
            if (window.Auth && typeof Auth.ensureAuth === 'function') {
              await Auth.ensureAuth(requiredRoles);
            }
            showNav();
          } catch (e) {
            console.warn('ensureAuth early init error:', e);
          }
        })();
      </script>
    {{/head-block}}
  </head>

  <!-- BEGIN Body -->
  <body class="mod-bg-1 mod-nav-link {{preemptiveclass}}" data-required-roles="{{requiredRoles}}">
    
    {{!-- save-settings-script --}}
    {{> include/_scripts-loading-saving}}
    
    <!-- BEGIN Page Wrapper -->
    <div class="page-wrapper">
      <div class="page-inner">

        {{> include/_left-panel }}

        <div class="page-content-wrapper">
          
          {{> include/_page-header }}

          <!-- BEGIN Page Content -->
          <main id="js-page-content" role="main" class="page-content">
            {{#if preemptiveclass}}
              <!-- Page heading removed for composed layout -->
            {{else}}
              {{> include/_page-breadcrumb }}
              <div class="subheader">
                {{> include/_page-heading }}
                {{#> subheader-block}}{{/subheader-block}}
              </div>
            {{/if}}
            {{#>content-block}}{{/content-block}}
          </main>
          <!-- END Page Content -->

          {{> include/_page-content-overlay }}
          {{> include/_page-footer }}
          {{> include/_shortcut-modal }}
          {{> include/_color-profile-reference }}
          
        </div>
      </div>
    </div>
    <!-- END Page Wrapper -->
    
    {{> include/_shortcut-menu }}
    {{> include/_shortcut-messenger }}
    {{> include/_page-settings }}
    {{> include/_google_analytics }}

    {{!-- 先載入 SmartAdmin bundles --}}
    {{> include/_scripts-base-plugins}}

    <!-- 固定載入 logout.js，避免被覆蓋 -->
    <script src="js/logout.js" defer></script>

    {{#>scripts-block}}
      {{> @partial-block}}
    {{/scripts-block}}
  </body>
  <!-- END Body -->
</html>
