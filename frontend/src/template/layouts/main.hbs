<!DOCTYPE html>
{{> include/_copyright-header}}
<html lang="en">
  <head>
    {{> include/_head}}

    {{#> head-block}}
      <!-- 1) 全站認證工具（只載一次） -->
      <script src="js/auth.js"></script>

      <!-- 2) ultra-early：從快取角色避免閃爍（改外部檔，且不要 defer） -->
      <script src="js/early/role-cache.js"></script>

      <!-- 3) 防閃爍 CSS（改外部檔） -->
      <link rel="stylesheet" href="/css/early/anti-fou.css">

      <!-- 4) 需要的其他 head 資源（若有） -->
      {{#each page-settings.js}}
        <script src="{{this}}" defer></script>
      {{/each}}

      <!-- 5) 提前執行 ensureAuth（改外部檔，建議 defer） -->
      <script src="js/early/ensure-auth.js" defer></script>
    {{/head-block}}
  </head>

  <!-- BEGIN Body -->
  <body class="mod-bg-1 mod-nav-link {{preemptiveclass}}" data-required-roles="{{requiredRoles}}">
    
    {{!-- save-settings-script --}}
    {{> include/_scripts-loading-saving}}
    
    <!-- BEGIN Page Wrapper -->
    <div class="page-wrapper">
      <div class="page-inner">

        {{> include/_left-panel }}

        <div class="page-content-wrapper">
          
          {{> include/_page-header }}

          <!-- BEGIN Page Content -->
          <main id="js-page-content" role="main" class="page-content">
            {{#if preemptiveclass}}
              <!-- Page heading removed for composed layout -->
            {{else}}
              {{> include/_page-breadcrumb }}
              <div class="subheader">
                {{> include/_page-heading }}
                {{#> subheader-block}}{{/subheader-block}}
              </div>
            {{/if}}
            {{#>content-block}}{{/content-block}}
          </main>
          <!-- END Page Content -->

          {{> include/_page-content-overlay }}
          {{> include/_page-footer }}
          {{> include/_shortcut-modal }}
          {{> include/_color-profile-reference }}
          
        </div>
      </div>
    </div>
    <!-- END Page Wrapper -->
    
    {{> include/_shortcut-menu }}
    {{> include/_shortcut-messenger }}
    {{> include/_page-settings }}
    {{> include/_google_analytics }}

    {{!-- 先載入 SmartAdmin bundles --}}
    {{> include/_scripts-base-plugins}}

    <!-- 固定載入 logout.js，避免被覆蓋 -->
    <script src="js/logout.js" defer></script>

    {{#>scripts-block}}
      {{> @partial-block}}
    {{/scripts-block}}
  </body>
  <!-- END Body -->
</html>
